# Application
APP_NAME=Currency Converter API
APP_ENV=development
APP_VERSION=2.0.0
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
API_V2_PREFIX=/api/v2

# Exchange rate provider
EXCHANGE_PROVIDER=frankfurter
EXCHANGE_API=https://api.frankfurter.app/latest
EXCHANGE_TIMEOUT_SECONDS=5
EXCHANGE_MAX_RETRIES=2

# Rate freshness
RATE_CACHE_TTL_SECONDS=3600
MAX_STALE_RATE_AGE_SECONDS=86400

# Redis (optional until caching/rate limiting is implemented)
REDIS_URL=redis://localhost:6379/0

# Database (optional until persistence is implemented)
DATABASE_URL=

# API key authentication
API_KEY_AUTH_ENABLED=false
API_KEY_PEPPER=

# Rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Usage quotas
USAGE_QUOTA_ENABLED=false
MONTHLY_REQUEST_QUOTA=10000

# Observability
METRICS_ENABLED=true
METRICS_PATH=/metrics
REQUEST_ID_HEADER=X-Request-ID

# CORS: configure explicit origins if browser clients need access
CORS_ALLOWED_ORIGINS=

# HTTP client
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# Testing
TESTING=false
